<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Picker_Becerra.MainPage"
             Title="Portal de Admisiones"
             BackgroundColor="#FFFFFF">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- 1. Barra superior institucional -->
            <Grid BackgroundColor="White" Padding="15,10" ColumnDefinitions="*, Auto">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <!-- Simulación del Logo Institucional -->
                    <Label Text="■ SUDAMERICANO" FontAttributes="Bold" FontSize="16" TextColor="#005B96" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Label Text="Portal de Admisiones" Grid.Column="1" FontAttributes="Bold" FontSize="15" TextColor="#005B96" VerticalOptions="Center"/>
            </Grid>

            <!-- 2. Barra azul de sección -->
            <BoxView HeightRequest="3" Color="#003366" />
            <Grid BackgroundColor="#003366" Padding="15,8">
                <Label Text="Formulario de Matrícula" TextColor="White" FontSize="14" FontAttributes="Bold"/>
            </Grid>

            <!-- 3. Contenido Principal -->
            <VerticalStackLayout Spacing="15" Padding="20">

                <!-- Título FASE A - GRADO -->
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                    <Label Text="FASE A - GRADO" FontAttributes="Bold" FontSize="18" TextColor="#003366" HorizontalOptions="Center"/>
                    <Label Text="Formulario de registro" FontSize="13" TextColor="#555" HorizontalOptions="Center"/>
                    <Label Text="Complete la siguiente información para realizar su inscripción." FontSize="12" TextColor="#666" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Distribución adaptable de 2 columnas (Formulario izquierda, Panel derecha) -->
                <Grid RowDefinitions="Auto" ColumnDefinitions="*, 280" ColumnSpacing="15">

                    <!-- COLUMNA IZQUIERDA: Formulario de Registro -->
                    <Border Grid.Column="0" Stroke="#B0C4DE" StrokeThickness="1" BackgroundColor="White" Padding="15">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Datos Personales" FontAttributes="Bold" TextColor="#333" FontSize="13" />
                            <BoxView HeightRequest="1" Color="#DCDCDC" Margin="0,-5,0,0"/>

                            <!-- Identificación -->
                            <Grid ColumnDefinitions="110, *" ColumnSpacing="8">
                                <Picker x:Name="PckTipoId" Title="CÉDULA" TextColor="Black" TitleColor="Black" FontSize="13" BackgroundColor="#FAFAFA">
                                    <Picker.Items>
                                        <x:String>CÉDULA</x:String>
                                        <x:String>PASAPORTE</x:String>
                                    </Picker.Items>
                                </Picker>
                                <Entry x:Name="TxtNumeroId" Grid.Column="1" Placeholder="Número" TextColor="Black" PlaceholderColor="#888" FontSize="13" Keyboard="Numeric" BackgroundColor="#FAFAFA" />
                            </Grid>

                            <!-- Apellidos -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                <Entry x:Name="TxtPaterno" Placeholder="Paterno" TextColor="Black" PlaceholderColor="#888" FontSize="13" BackgroundColor="#FAFAFA" />
                                <Entry x:Name="TxtMaterno" Grid.Column="1" Placeholder="Materno" TextColor="Black" PlaceholderColor="#888" FontSize="13" BackgroundColor="#FAFAFA" />
                            </Grid>

                            <!-- Nombres completos -->
                            <Entry x:Name="TxtNombres" Placeholder="Nombres completos" TextColor="Black" PlaceholderColor="#888" FontSize="13" BackgroundColor="#FAFAFA" />

                            <!-- Teléfono -->
                            <Entry x:Name="TxtTelefono" Placeholder="Teléfono personal" TextColor="Black" PlaceholderColor="#888" FontSize="13" Keyboard="Telephone" BackgroundColor="#FAFAFA" />

                            <!-- Correo personal -->
                            <Entry x:Name="TxtCorreo" Placeholder="Correo personal" TextColor="Black" PlaceholderColor="#888" FontSize="13" Keyboard="Email" BackgroundColor="#FAFAFA" />

                            <!-- Confirmar correo -->
                            <Entry x:Name="TxtConfirmarCorreo" Placeholder="Confirmar correo" TextColor="Black" PlaceholderColor="#888" FontSize="13" Keyboard="Email" BackgroundColor="#FAFAFA" />

                            <!-- Selectores Académicos -->
                            <Picker x:Name="PckCarrera" Title="Seleccione Carrera" TextColor="Black" TitleColor="#666" FontSize="13" BackgroundColor="#FAFAFA">
                                <Picker.Items>
                                    <x:String>Desarrollo de Software</x:String>
                                    <x:String>Diseño Gráfico</x:String>
                                    <x:String>Administración</x:String>
                                </Picker.Items>
                            </Picker>

                            <Picker x:Name="PckModalidad" Title="Seleccione Modalidad" TextColor="Black" TitleColor="#666" FontSize="13" BackgroundColor="#FAFAFA">
                                <Picker.Items>
                                    <x:String>Presencial</x:String>
                                    <x:String>En Línea</x:String>
                                </Picker.Items>
                            </Picker>

                            <Picker x:Name="PckCampus" Title="Seleccione Campus" TextColor="Black" TitleColor="#666" FontSize="13" BackgroundColor="#FAFAFA">
                                <Picker.Items>
                                    <x:String>Matriz</x:String>
                                    <x:String>Campus Norte</x:String>
                                </Picker.Items>
                            </Picker>

                            <!-- Botón de Envío -->
                            <Button Text="Enviar inscripción" 
                                    BackgroundColor="#EFEFEF" 
                                    TextColor="#333" 
                                    BorderColor="#CCCCCC"
                                    BorderWidth="1"
                                    FontAttributes="Bold"
                                    HeightRequest="40"
                                    CornerRadius="4"
                                    Margin="0,10,0,0"
                                    Clicked="OnEnviarInscripcionClicked" />

                        </VerticalStackLayout>
                    </Border>

                    <!-- COLUMNA DERECHA: Panel de Información y Enlaces (Estilo Maqueta Original) -->
                    <VerticalStackLayout Grid.Column="1" Spacing="15">

                        <!-- Caja de Información -->
                        <Border BackgroundColor="#005B96" Padding="12" StrokeThickness="0">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Información" TextColor="White" FontAttributes="Bold" FontSize="13" />
                                <BoxView HeightRequest="1" Color="#4A90E2" />
                                <Label Text="📞 098 648 3805" TextColor="White" FontSize="11" />
                                <Label Text="📞 02 255 5741 - Ext. 101/102" TextColor="White" FontSize="11" />
                                <Label Text="✉️ info@sudamericano.edu.ec" TextColor="White" FontSize="11" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Caja de Enlaces -->
                        <Border BackgroundColor="#F1F3F5" Stroke="#DCDCDC" StrokeThickness="1" Padding="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Enlaces" TextColor="#333" FontAttributes="Bold" FontSize="13" />
                                <BoxView HeightRequest="1" Color="#CCCCCC" />
                                <Label Text=">> Preguntas Frecuentes" TextColor="#005B96" FontSize="11" />
                                <Label Text=">> Calendario Académico" TextColor="#005B96" FontSize="11" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                </Grid>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>